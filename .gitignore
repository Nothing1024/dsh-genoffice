# dependencies — pnpm-managed, never commit
node_modules/

# test / tool caches
.vite/
__pycache__/
coverage/
*.tsbuildinfo
# accidental tsc emit next to TypeScript sources
packages/*/src/**/*.js

# logs
*.log
# ...except PRD 包归档的验收证据（spec 5.3 要求 evidence/ 目录完整入库）
!docs/*/evidence/**/*.log

# local DSH_HOME (loopback profile). Recipe files are tracked; runtime is not.
env/.env
env/.credentials.yaml
env/.anonymous-user-id
env/sessions/
env/storages/
env/settings.yaml
env/settings.yaml.imported
env/AGENTS.md
env/attachments/
env/profiles/*/node_modules/
env/profiles/*/pnpm-lock.yaml

# Finder
.DS_Store

# local-only artifacts: agent session exports, symlinks into /tmp
omp-session-*.html
docs/web-runtime-efficiency/isolated-engine
