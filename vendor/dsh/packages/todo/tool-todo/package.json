{
  "name": "@deepseek-ai/dsh-tool-todo",
  "description": "Model-facing todo_write tool over the DeepSeek Harness event-sourced session log",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1",
    "@deepseek-ai/dsh-session": "^0.0.1",
    "@deepseek-ai/dsh-session-projection": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../../core/agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "file:../../support/agent-loop-testkit",
    "@deepseek-ai/dsh-host-apiproxy": "file:../../host/apiproxy",
    "@deepseek-ai/dsh-invariants": "file:../../support/invariants",
    "@deepseek-ai/dsh-llm": "file:../../llm/llm",
    "@deepseek-ai/dsh-session": "file:../../core/session",
    "@deepseek-ai/dsh-session-projection": "file:../../session-projection/session-projection",
    "@deepseek-ai/dsh-system-prompt": "file:../../core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../../core/tools",
    "@deepseek-ai/dsh-user-interaction": "file:../../ui/user-interaction",
    "cordis": "^4.0.0-rc.7"
  }
}
