{
  "name": "@deepseek-ai/dsh-llm-retry",
  "description": "Provider-routed LLM request retry policy for the DeepSeek Harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.0.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-session": "^0.0.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "file:../../../vendor/include",
    "@cordisjs/plugin-loader": "file:../../../vendor/loader",
    "@deepseek-ai/dsh-agent": "file:../../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../../core/agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "file:../../support/agent-loop-testkit",
    "@deepseek-ai/dsh-invariants": "file:../../support/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm",
    "@deepseek-ai/dsh-llm-deepseek": "file:../llm-deepseek",
    "@deepseek-ai/dsh-llm-mock-server": "file:../../support/llm-mock-server",
    "@deepseek-ai/dsh-session": "file:../../core/session",
    "@deepseek-ai/dsh-session-persistence-jsonl": "file:../../session-persistence/session-persistence-jsonl",
    "@deepseek-ai/dsh-session-persistence-sqlite": "file:../../session-persistence/session-persistence-sqlite",
    "@deepseek-ai/dsh-system-prompt": "file:../../core/system-prompt",
    "@deepseek-ai/dsh-timeout": "file:../../util/timeout",
    "@deepseek-ai/dsh-tools": "file:../../core/tools",
    "cordis": "^4.0.0-rc.7"
  }
}
